{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "figma": {
      "type": "local",
      "command": ["npx", "-y", "figma-developer-mcp", "--stdio"],
      "environment": {
        "FIGMA_API_KEY": "figd_yKCnxtwL4lami1GXIjyuNNB6QnJ9CyHYZVj64c7i"
      },
      "enabled": true
    },

    "magicui": {
      "type": "local",
      "command": ["npx", "-y", "@magicuidesign/mcp@latest"],
      "enabled": true
    },

    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },

    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    },

    "visuals": {
      "type": "local",
      "command": ["npx", "-y", "@harrybin/visuals-mcp@latest"],
      "enabled": true
    },

    "superpowers": {
      "type": "local",
      "command": ["npx", "-y", "superpowers-mcp@latest"],
      "enabled": true
    }
  }
}